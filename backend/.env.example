PORT=5000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
PRISMA_CONNECTION_LIMIT=4
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://default:PASSWORD@HOST:PORT
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
# Configurable primary generation model; classroom classification uses a single bounded request.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODERATION_MODEL=gemini-3.1-flash-lite
# Used once for vault answers or PDF transcription after a transient provider 5xx.
GEMINI_RAG_FALLBACK_MODEL=gemini-3.5-flash-lite
# Roles are chosen once at registration; switching is disabled.
ALLOW_ROLE_SWITCH=false

# Comma-separated exact frontend origins. Required in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
